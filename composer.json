{
    "name": "contenir/contenir-errors-mezzio",
    "description": "Mezzio (PSR-15) adapter for contenir/contenir-errors — renders admin-authored per-status pages for 4xx/5xx responses.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "contenir",
        "errors",
        "mezzio",
        "psr-15",
        "middleware"
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/contenir-config": "^2.1",
        "contenir/contenir-errors": "^2.1",
        "laminas/laminas-diactoros": "^3.0",
        "mezzio/mezzio-template": "^2.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "infection/infection": "^0.34.1",
        "laminas/laminas-view": "^2.30",
        "php-db/phpdb-qa-tools": "0.1.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "suggest": {
        "laminas/laminas-view": "Clears its head and script placeholders before the error page renders (mezzio-laminasviewrenderer sites)"
    },
    "replace": {
        "contenir/errors-mezzio": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Errors\\Mezzio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Errors\\Mezzio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "laminas": {
            "config-provider": "Contenir\\Errors\\Mezzio\\ConfigProvider"
        },
        "branch-alias": {
            "dev-main": "2.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
