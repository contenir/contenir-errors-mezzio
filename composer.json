{
    "name": "contenir/errors-mezzio",
    "description": "Mezzio (PSR-15) adapter for contenir/errors — renders admin-authored per-status pages for 4xx/5xx responses.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "contenir",
        "errors",
        "mezzio",
        "psr-15",
        "middleware"
    ],
    "require": {
        "php": "^8.3",
        "contenir/config": "^0.1",
        "contenir/errors": "^0.1",
        "laminas/laminas-diactoros": "^3.0",
        "mezzio/mezzio-template": "^2.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "laminas/laminas-view": "^2.30",
        "php-db/phpdb-qa-tools": "0.1.x-dev",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "laminas/laminas-view": "Clears its head and script placeholders before the error page renders (mezzio-laminasviewrenderer sites)"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Contenir\\Errors\\Mezzio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Errors\\Mezzio\\Test\\": "test/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../contenir-errors",
            "canonical": false,
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../contenir-config",
            "canonical": false,
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/contenir/errors"
        },
        {
            "type": "vcs",
            "url": "https://github.com/contenir/config"
        }
    ],
    "extra": {
        "laminas": {
            "config-provider": "Contenir\\Errors\\Mezzio\\ConfigProvider"
        }
    },
    "scripts": {
        "check": [
            "@quality",
            "@test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "analyze": "mago analyze",
        "quality": [
            "@cs-check",
            "@analyze"
        ],
        "quality:fix": [
            "@cs-fix",
            "@quality"
        ],
        "test": "phpunit --colors=always",
        "test:unit": "phpunit --colors=always --testsuite unit",
        "test:integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --colors=always --coverage-clover clover.xml --coverage-text",
        "pre-commit": [
            "@quality",
            "@test"
        ],
        "ci": [
            "@quality",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.22"
        }
    }
}
